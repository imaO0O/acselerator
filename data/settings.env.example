# Настройки установки. Скопируйте в data\settings.env и заполните нужное: строки KB_…=значение, # — комментарий.
# Их одинаково видят чат, REST API и задачи по расписанию (scripts\install_tasks.bat). Переменная окружения,
# если задана, важнее файла. Пароли сюда не пишите: почта — data\mail_password.txt, 1С — data\1c_password.txt
# (в git и резервную копию не входят). После правки перезапустите чат; задачи по расписанию подхватят сами.

# Папка документов отдела (сетевая или локальная): новые и изменённые файлы подключаются сами
# KB_DOCS_FOLDER=\\server\Документы\Техотдел
# доступ документов папки без записи в реестре: all — всем ролям, production, metrology, admin
# KB_DOCS_FOLDER_ACCESS=all

# Почтовый ящик отдела (IMAP, только чтение): письма клиентов → «Входящие запросы» с разбором ТКП
# KB_MAIL_HOST=mail.zavod.ru
# KB_MAIL_PORT=993
# KB_MAIL_USER=sales@zavod.ru
# KB_MAIL_FOLDER=INBOX

# Цены и остатки из 1С (OData, только чтение): bp — Бухгалтерия 3.0, ut — УТ 11 / КА 2 / ERP
# KB_1C_URL=http://1c-server/base/odata/standard.odata
# KB_1C_USER=agent_read
# KB_1C_PRICE_TYPE=Оптовая
# KB_1C_CONFIG=bp
# KB_1C_STOCK=0

# ТКП: ставка НДС, % (0 — без НДС) и включён ли он в цены прайса — сверить с бухгалтерией
# KB_VAT_RATE=22
# KB_PRICES_WITH_VAT=1

# Сколько дней хранить журнал вопросов (0 — без ограничения)
# KB_LOG_RETENTION_DAYS=180
