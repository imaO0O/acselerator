# модели и сборки llama.cpp ставятся отдельно (scripts/setup_models.py)
models/
tools/
*.gguf

# резервные копии данных заказчика (scripts/backup.py) — хэши паролей и журналы
backups/

# производные данные
data/index/
logs/
eval/results/*.jsonl

__pycache__/
*.pyc
.venv/
.streamlit/secrets.toml


# реферат и депонируемые материалы — собираются scripts/make_deposit.py из текущего кода
docs/registraciya/out/

# данные партнёра (коммерческая тайна): документы, реестр, вопросы, справочник и прайс, результаты прогонов
data/raw/partner/
data/partner_import/
# реестр ТКП, бланк и условия компании, утверждённые ТКП
data/tkp/
# входящие запросы из почты и пароль ящика
data/mail/
data/mail_password.txt
# настройки установки (папка отдела, почта, 1С) — у каждого заказчика свои
data/settings.env
data/1c_password.txt
eval/partner*.yaml
eval/priemka*.yaml
eval/results/partner*
# прогоны проверки ветки (scripts/check_branch.py); сам отчёт можно закоммитить
eval/results/check_*
!eval/results/check_branch.md
eval/results/priemka*
*_oshibki.csv

# документы, загруженные через чат (могут быть конфиденциальными)
data/raw/uploaded/
data/show/

# демо-база пересоздаётся при запуске с датами от текущего дня (scripts/make_demo_db.py)
data/demo_db/uchet.sqlite
data/demo_db/dates.json

# ключи API (только хэши) — выпускаются на месте установки
data/api_keys.yaml
# ключ доступа к серверам моделей — создаётся при первом запуске start_servers
data/model_api_key.txt

# справочник параметров: отчёт о загрузке и предыдущая версия файла — производные
data/spravochnik/import.json
data/spravochnik/pribory.prev.csv
# прайс: предыдущая версия файла — производная
data/spravochnik/prajs.prev.csv
data/spravochnik/upload.*
